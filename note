


////////////////////////////////////////////////////////////////////////////////////


/joint_states

es el topico en que se debe publicar para que envie a los motores
pero el que se subscribe a ese topico es el nodo 


piper_ctrl_single_node

este es el que se subsrube al topico joint_states y  envia las posicones a los motores

entonces lo que ahora hace mi nodo de

piper_cartesian_controller.py 
es publicar en joint_states 




//////////////////////////////////////////////////////////////
CORRER LAUNCH  LAPTOP


ros2 launch piper piper_cartesian.launch.py 



ros2 launch piper_kinematics cartesian.launch.py 



ros2 run piper_kinematics keyboard_controller.py




para una posicion target   ----> tiene que ser mayor a 0.25 en z y mayor a 0.1 en x 

ros2 topic pub /piper_cartesian_target geometry_msgs/msg/Point "{x: 0.4, y: 0.0, z: 0.5}" --once




////////////////////////////////////////////////////////////////////////////////////////////
CORRER LAUNCH DESDE JETSON 


bash can_activate.sh can_piper 1000000 "1-2.4:1.0"



ros2 run piper piper_single_ctrl --ros-args-p can_port:=can_piper -p auto_enable:=false -p griper_exist:=true -p gripper_val_multiple:=2


ros2 launch piper piper_cartesian.launch.py can_port:=can_piper


ros2 launch piper_kinematics cartesian.launch.py 







para FOXGLOVE


ros2 run foxglove_bridge foxglove_bridge --port 8765






en la LAPTOP...........ABRIR FOXGLOVE

 
 //opcional
ros2 launch foxglove_bridge foxglove_bridge_launch.xml


para posiciones relativas topico 

/piper_artesian_delta

para posiciones fijas 

/piper_cartesian_target ....................................x>0.1  z>025 


